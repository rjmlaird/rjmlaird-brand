---
import Layout from "../layouts/Layout.astro";
import DoDont from "../components/DoDont.astro";
import meta from "../data/logos.generated.json";
import { ratio, fmt } from "../lib/contrast";

const L = "/assets/logos/";
const tealOnLight = fmt(ratio("#00C2A8", "#EDEAE3"));

const lockups = [
  { id: "horizontal", name: "Horizontal", use: "The default. Websites, documents, slides, email, headers and footers.", dims: meta.horizontal },
  { id: "stacked", name: "Stacked", use: "Square and portrait spaces: social profiles, posters, report covers, merchandise.", dims: meta.stacked },
  { id: "wordmark", name: "Wordmark", use: "Tight, wide spaces where the orbit mark already appears nearby.", dims: meta.wordmark },
  { id: "mark", name: "Orbit mark", use: "Favicons, avatars and app icons, and as a graphic device on its own.", dims: meta.mark },
];

const colourways = [
  { id: "colour-on-dark", name: "Colour on dark", bg: "#0B0F1A", use: "The primary version. On Ink, Card, Lift and other dark surfaces." },
  { id: "ink", name: "Ink", bg: "#EDEAE3", use: "One-colour version for Warm White, white and light photography." },
  { id: "white", name: "White", bg: "#1A2236", use: "One-colour version for photography and brand-colour fills that are dark enough." },
];

const mins = [
  { name: "Horizontal", digital: "120 px wide", print: "30 mm wide", px: 120, id: "horizontal" },
  { name: "Stacked", digital: "72 px wide", print: "20 mm wide", px: 72, id: "stacked" },
  { name: "Wordmark", digital: "88 px wide", print: "22 mm wide", px: 88, id: "wordmark" },
  { name: "Orbit mark", digital: "16 px", print: "6 mm", px: 16, id: "mark" },
];

// Clear space X = cap height of the wordmark, as a fraction of lockup height.
const demoH = 96;
const x = Math.round(meta.horizontal.capRatio * demoH);
---

<Layout title="Logo" description="The RJM Laird orbit mark and wordmark: lockups, colourways, clear space, minimum sizes and misuse.">
  <header class="page-head">
    <p class="kk">Logo</p>
    <h1>One mark. Every scale.</h1>
    <p class="lede">
      The identity is an orbit mark beside a two-tone wordmark: <strong>RJM</strong> in warm white and <strong>Laird</strong> in teal,
      set in Space Grotesk Bold. Every file is outlined, so nothing depends on an installed font.
    </p>
  </header>

  <section class="band band--alt" aria-labelledby="primary">
    <p class="sl">Primary logo</p>
    <h2 class="h2" id="primary">The horizontal lockup, <em>on Ink.</em></h2>
    <div class="stage stage--ink">
      <img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="RJM Laird primary logo" width={meta.horizontal.w} height={meta.horizontal.h} />
    </div>
    <div class="split" style="margin-top:2rem">
      <ul class="copy">
        <li><strong>Orbit mark.</strong> An outer ring with a planet, an inner ring and a nucleus. It echoes the rotating rings in the site hero.</li>
        <li><strong>Wordmark.</strong> “RJM” in Warm White and “Laird” in Teal, one word with no space. Space Grotesk Bold, +4% tracking.</li>
        <li><strong>Never retype it.</strong> Always place an exported file. Retyping changes weights, tracking and kerning.</li>
      </ul>
      <dl class="spec">
        <dt>Typeface</dt><dd>Space Grotesk Bold (700)</dd>
        <dt>Tracking</dt><dd>+0.04em</dd>
        <dt>Mark colours</dt><dd>Warm White #EDEAE3 · Teal #00C2A8</dd>
        <dt>Wordmark colours</dt><dd>Warm White #EDEAE3 · Teal #00C2A8</dd>
        <dt>Formats</dt><dd>SVG (outlined) and PNG (transparent)</dd>
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="lockups">
    <p class="sl">Lockups</p>
    <h2 class="h2" id="lockups">Four arrangements, <em>one job each.</em></h2>
    <ul class="grid" style="--min:28rem;margin-top:2rem">
      {lockups.map((l) => (
        <li class="card">
          <div class="stage stage--ink stage--sm">
            <img src={`${L}rjmlaird-${l.id}-colour-on-dark.svg`} alt={`${l.name} lockup`} width={l.dims.w} height={l.dims.h} style={l.id === "mark" ? "height:5.5rem;width:auto" : l.id === "stacked" ? "height:8rem;width:auto" : "width:min(100%,17rem);height:auto"} />
          </div>
          <h3>{l.name}</h3>
          <p>{l.use}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="band band--alt" aria-labelledby="colourways">
    <p class="sl">Colourways</p>
    <h2 class="h2" id="colourways">Match the version <em>to the background.</em></h2>
    <ul class="grid" style="--min:18rem;margin:2rem 0">
      {colourways.map((c) => (
        <li class="card">
          <div class="stage stage--sm" style={`background:${c.bg}`}>
            <img src={`${L}rjmlaird-horizontal-${c.id}.svg`} alt={`${c.name} logo`} style="width:min(100%,15rem);height:auto" />
          </div>
          <h3>{c.name}</h3>
          <p>{c.use}</p>
        </li>
      ))}
    </ul>
    <div class="callout callout--amber">
      <h3>Never use the colour version on light</h3>
      <p>Teal on Warm White is only <strong>{tealOnLight}:1</strong>, well below the 3:1 needed for a graphic. On light backgrounds use the Ink version, which is 15.9:1 on Warm White.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="space">
    <p class="sl">Clear space</p>
    <h2 class="h2" id="space">Keep a margin <em>of X on every side.</em></h2>
    <div class="split" style="margin-top:2rem">
      <div class="clear" style={`--x:${x}px;--h:${demoH}px`}>
        <div class="clear__box">
          <img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Horizontal logo shown inside its clear-space boundary" style={`height:${demoH}px;width:auto`} />
          <span class="clear__x clear__x--t" aria-hidden="true">X</span>
          <span class="clear__x clear__x--b" aria-hidden="true">X</span>
          <span class="clear__x clear__x--l" aria-hidden="true">X</span>
          <span class="clear__x clear__x--r" aria-hidden="true">X</span>
        </div>
      </div>
      <div class="copy">
        <p><strong>X is the cap height of the wordmark</strong> (the height of the “R”). In the horizontal lockup that is about {Math.round(meta.horizontal.capRatio * 100)}% of the logo’s height.</p>
        <p>Nothing enters this zone: no text, edges, images or other logos. Where space is genuinely tight, X may drop to half, but never for print covers or partner lockups.</p>
      </div>
    </div>
  </section>

  <section class="band band--alt" aria-labelledby="sizes">
    <p class="sl">Minimum sizes</p>
    <h2 class="h2" id="sizes">Small, <em>but never fiddly.</em></h2>
    <div class="table-wrap" role="region" aria-label="Minimum logo sizes" tabindex="0" style="margin-top:2rem">
      <table class="table">
        <caption>Smallest permitted reproduction</caption>
        <thead><tr><th scope="col">Lockup</th><th scope="col">Digital</th><th scope="col">Print</th><th scope="col">Shown at minimum</th></tr></thead>
        <tbody>
          {mins.map((m) => (
            <tr>
              <th scope="row">{m.name}</th><td>{m.digital}</td><td>{m.print}</td>
              <td><img src={`${L}rjmlaird-${m.id}-colour-on-dark.svg`} alt={`${m.name} at its minimum size`} style={`width:${m.px}px;height:auto;background:#0B0F1A;padding:6px;border-radius:3px`} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="copy" style="margin-top:1rem">The favicon uses a simplified orbit mark with heavier strokes so it survives at 16 px. Don’t scale the full mark below its minimum.</p>
  </section>

  <section class="band" aria-labelledby="misuse">
    <p class="sl">Misuse</p>
    <h2 class="h2" id="misuse">Please <em>don’t.</em></h2>
    <ul class="grid" style="--min:16rem;margin-top:2rem">
      <li><DoDont kind="do" caption="Use an exported file on a dark surface, with clear space."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Correct logo" style="width:13rem" /></DoDont></li>
      <li><DoDont kind="dont" caption="Stretch or squash it."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Logo stretched horizontally, incorrect" style="width:13rem;height:3.2rem" /></DoDont></li>
      <li><DoDont kind="dont" caption="Rotate or tilt it."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Logo rotated, incorrect" style="width:12rem;transform:rotate(-12deg)" /></DoDont></li>
      <li><DoDont kind="dont" caption="Recolour it."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Logo with shifted hue, incorrect" style="width:13rem;filter:hue-rotate(110deg)" /></DoDont></li>
      <li><DoDont kind="dont" bg="#EDEAE3" caption={`Put the colour version on light. Teal is ${tealOnLight}:1 there.`}><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Colour logo on a light background, incorrect" style="width:13rem" /></DoDont></li>
      <li><DoDont kind="dont" caption="Add shadows, glows or outlines."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Logo with a glow effect, incorrect" style="width:13rem;filter:drop-shadow(0 0 10px #00C2A8)" /></DoDont></li>
      <li><DoDont kind="dont" caption="Swap the colours or retype it in another font."><span aria-label="Retyped wordmark in a serif font with swapped colours, incorrect" role="img" style="font:700 2rem Georgia,serif;color:#00C2A8">RJM<span style="color:#EDEAE3">Laird</span></span></DoDont></li>
      <li><DoDont kind="dont" bg="repeating-linear-gradient(45deg,#00C2A8 0 14px,#38BDF8 14px 28px)" caption="Place it on busy or low-contrast backgrounds."><img src={`${L}rjmlaird-horizontal-colour-on-dark.svg`} alt="Logo on a busy striped background, incorrect" style="width:13rem" /></DoDont></li>
    </ul>
  </section>

  <section class="band band--alt" aria-label="Downloads">
    <p class="sl">Assets</p>
    <p class="lede" style="margin-bottom:1.5rem">All 12 logo files, as outlined SVG and transparent PNG, are on the downloads page.</p>
    <a class="btn btn--primary" href="/downloads/">Get the logo files <span aria-hidden="true">→</span></a>
  </section>
</Layout>

<style>
  .stage { display: grid; place-items: center; padding: clamp(2rem, 6vw, 4rem); border: 1px solid var(--bd); border-radius: var(--radius); }
  .stage--ink { background: var(--ink); }
  .stage--sm { padding: 1.75rem 1rem; min-height: 9.5rem; }
  .stage img { max-width: 100%; height: auto; }
  .stage:not(.stage--sm) img { width: min(100%, 30rem); }
  ul.grid { list-style: none; }
  .copy li { list-style: disc; margin-left: 1.25rem; }

  .clear { display: grid; place-items: center; padding: 1.5rem; background: var(--ink); border: 1px solid var(--bd); border-radius: var(--radius); overflow-x: auto; }
  .clear__box {
    position: relative; padding: var(--x);
    outline: 1px dashed var(--teal); outline-offset: 0;
    background: repeating-linear-gradient(45deg, rgba(0,194,168,.08) 0 6px, transparent 6px 12px);
  }
  .clear__box img { position: relative; display: block; background: var(--ink); }
  .clear__x {
    position: absolute; display: grid; place-items: center; width: var(--x); height: var(--x);
    font-family: var(--font-mono); font-size: .75rem; font-weight: 600; color: var(--teal);
  }
  .clear__x--t { top: 0; left: calc(50% - var(--x) / 2); }
  .clear__x--b { bottom: 0; left: calc(50% - var(--x) / 2); }
  .clear__x--l { left: 0; top: calc(50% - var(--x) / 2); }
  .clear__x--r { right: 0; top: calc(50% - var(--x) / 2); }
</style>
